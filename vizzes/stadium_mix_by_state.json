{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 320,
  "data": {
    "url": "data/all_stadiums.csv",
    "format": {
      "type": "csv"
    }
  },
  "transform": [
    {
      "aggregate": [
        {
          "op": "count",
          "as": "StadiumCount"
        }
      ],
      "groupby": [
        "State",
        "Shape"
      ]
    }
  ],
  "mark": {
    "type": "bar"
  },
  "encoding": {
    "x": {
      "field": "StadiumCount",
      "type": "quantitative",
      "stack": "normalize",
      "axis": {
        "title": "Share of stadiums",
        "format": "%",
        "tickCount": 5
      }
    },
    "y": {
      "field": "State",
      "type": "nominal",
      "sort": "-x",
      "axis": {
        "title": "State or territory",
        "labelLimit": 190
      }
    },
    "color": {
      "field": "Shape",
      "type": "nominal",
      "title": "Stadium type",
      "scale": {
        "domain": [
          "Oval",
          "Rectangular",
          "Diamond",
          "Convertible",
          "Rectangular, with Athletics track"
        ],
        "range": [
          "#4e79a7",
          "#f28e2b",
          "#59a14f",
          "#e15759",
          "#b07aa1"
        ]
      }
    },
    "tooltip": [
      {
        "field": "State",
        "type": "nominal",
        "title": "State or territory"
      },
      {
        "field": "Shape",
        "type": "nominal",
        "title": "Stadium type"
      },
      {
        "field": "StadiumCount",
        "type": "quantitative",
        "title": "Stadiums"
      }
    ]
  },
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "config": {
    "font": "DM Sans",
    "title": {
      "font": "Manrope",
      "fontSize": 15,
      "fontWeight": 700,
      "color": "#172b35",
      "subtitleFont": "DM Sans",
      "subtitleFontSize": 12,
      "subtitleColor": "#5c6c73",
      "anchor": "middle"
    },
    "axis": {
      "labelFont": "DM Sans",
      "labelFontSize": 11,
      "labelColor": "#5c6c73",
      "titleFont": "DM Sans",
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "titleColor": "#172b35"
    },
    "legend": {
      "labelFont": "DM Sans",
      "labelFontSize": 11,
      "labelColor": "#172b35",
      "titleFont": "DM Sans",
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "titleColor": "#172b35"
    },
    "header": {
      "labelFont": "DM Sans",
      "labelFontSize": 11,
      "labelColor": "#5c6c73",
      "titleFont": "DM Sans",
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "titleColor": "#172b35"
    }
  },
  "title": "Stadium Type Mix by State"
}
