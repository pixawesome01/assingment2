{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 280,
  "data": {
    "url": "data/stadium_type_sport_attendance.csv",
    "format": {
      "type": "csv",
      "parse": {
        "MatchedVenues": "number",
        "EventCount": "number",
        "TotalAttendance": "number",
        "AverageAttendance": "number"
      }
    }
  },
  "mark": {
    "type": "rect",
    "stroke": "white",
    "strokeWidth": 2
  },
  "encoding": {
    "x": {
      "field": "Sport",
      "type": "nominal",
      "sort": [
        "AFL",
        "Cricket",
        "Football",
        "Rugby League",
        "Rugby Union"
      ],
      "axis": {
        "title": "Sport",
        "labelAngle": -25
      }
    },
    "y": {
      "field": "Shape",
      "type": "nominal",
      "sort": [
        "Oval",
        "Rectangular",
        "Convertible",
        "Rectangular, with Athletics track"
      ],
      "scale": {
        "domain": [
          "Oval",
          "Rectangular",
          "Convertible",
          "Rectangular, with Athletics track"
        ]
      },
      "axis": {
        "title": "Stadium type",
        "labelLimit": 230
      }
    },
    "color": {
      "field": "AverageAttendance",
      "type": "quantitative",
      "title": "Average attendance",
      "scale": {
        "range": ["#f28e2b", "#df711b", "#c65f16", "#a94c0d", "#8c2d04"]
      },
      "legend": {
        "format": ",.0f"
      }
    },
    "tooltip": [
      {
        "field": "Shape",
        "type": "nominal",
        "title": "Stadium type"
      },
      {
        "field": "Sport",
        "type": "nominal"
      },
      {
        "field": "AverageAttendance",
        "type": "quantitative",
        "title": "Event-weighted average attendance",
        "format": ",.0f"
      },
      {
        "field": "EventCount",
        "type": "quantitative",
        "title": "Events"
      }
    ]
  },
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "config": {
    "font": "DM Sans",
    "title": {
      "font": "Manrope",
      "fontSize": 15,
      "fontWeight": 700,
      "color": "#172b35",
      "subtitleFont": "DM Sans",
      "subtitleFontSize": 12,
      "subtitleColor": "#5c6c73",
      "anchor": "middle"
    },
    "axis": {
      "labelFont": "DM Sans",
      "labelFontSize": 11,
      "labelColor": "#5c6c73",
      "titleFont": "DM Sans",
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "titleColor": "#172b35"
    },
    "legend": {
      "labelFont": "DM Sans",
      "labelFontSize": 11,
      "labelColor": "#172b35",
      "titleFont": "DM Sans",
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "titleColor": "#172b35"
    },
    "header": {
      "labelFont": "DM Sans",
      "labelFontSize": 11,
      "labelColor": "#5c6c73",
      "titleFont": "DM Sans",
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "titleColor": "#172b35"
    }
  },
  "title": {
    "text": "Average Attendance by Stadium Type and Sport",
    "subtitle": "Event-weighted average; blank cells have no matched attendance records."
  }
}
