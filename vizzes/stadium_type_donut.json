{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "width": 420,
    "height": 360,
    "title": "Share of Stadiums by Type",
    "data": {
        "url": "data/all_stadiums.csv",
        "format": {"type": "csv"}
    },
    "transform": [
        {
            "aggregate": [{"op": "count", "as": "StadiumCount"}],
            "groupby": ["Shape"]
        },
        {
            "joinaggregate": [{"op": "sum", "field": "StadiumCount", "as": "TotalStadiums"}]
        },
        {
            "calculate": "datum.StadiumCount / datum.TotalStadiums",
            "as": "Share"
        }
    ],
    "mark": {
        "type": "arc",
        "innerRadius": 90,
        "outerRadius": 155,
        "stroke": "white",
        "strokeWidth": 2
    },
    "encoding": {
        "theta": {"field": "StadiumCount", "type": "quantitative"},
        "color": {
            "field": "Shape",
            "type": "nominal",
            "title": "Stadium type",
            "scale": {
                "domain": ["Oval", "Rectangular", "Diamond", "Convertible", "Rectangular, with Athletics track"],
                "range": ["#4e79a7", "#f28e2b", "#59a14f", "#e15759", "#b07aa1"]
            }
        },
        "tooltip": [
            {"field": "Shape", "type": "nominal", "title": "Stadium type"},
            {"field": "StadiumCount", "type": "quantitative", "title": "Stadiums"},
            {"field": "Share", "type": "quantitative", "title": "Share", "format": ".1%"}
        ]
    },
    "view": {"stroke": null}
}