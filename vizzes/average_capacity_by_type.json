{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 300,
  "data": {
    "url": "data/all_stadiums.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Capacity": "number"
      }
    }
  },
  "transform": [
    {
      "aggregate": [
        {
          "op": "mean",
          "field": "Capacity",
          "as": "AverageCapacity"
        },
        {
          "op": "count",
          "as": "StadiumCount"
        }
      ],
      "groupby": [
        "Shape"
      ]
    }
  ],
  "mark": {
    "type": "bar",
    "color": "#b07aa1",
    "cornerRadiusEnd": 3
  },
  "encoding": {
    "y": {
      "field": "Shape",
      "type": "nominal",
      "sort": {
        "field": "AverageCapacity",
        "order": "descending"
      },
      "axis": {
        "title": "Stadium type",
        "labelLimit": 220
      }
    },
    "x": {
      "field": "AverageCapacity",
      "type": "quantitative",
      "axis": {
        "title": "Average capacity (seats)",
        "format": ",.0f"
      }
    },
    "tooltip": [
      {
        "field": "Shape",
        "type": "nominal",
        "title": "Stadium type"
      },
      {
        "field": "AverageCapacity",
        "type": "quantitative",
        "title": "Average capacity",
        "format": ",.0f"
      },
      {
        "field": "StadiumCount",
        "type": "quantitative",
        "title": "Stadiums"
      }
    ]
  },
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "config": {
    "font": "DM Sans",
    "title": {
      "font": "Manrope",
      "fontSize": 15,
      "fontWeight": 700,
      "color": "#172b35",
      "subtitleFont": "DM Sans",
      "subtitleFontSize": 12,
      "subtitleColor": "#5c6c73",
      "anchor": "middle"
    },
    "axis": {
      "labelFont": "DM Sans",
      "labelFontSize": 11,
      "labelColor": "#5c6c73",
      "titleFont": "DM Sans",
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "titleColor": "#172b35"
    },
    "legend": {
      "labelFont": "DM Sans",
      "labelFontSize": 11,
      "labelColor": "#172b35",
      "titleFont": "DM Sans",
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "titleColor": "#172b35"
    },
    "header": {
      "labelFont": "DM Sans",
      "labelFontSize": 11,
      "labelColor": "#5c6c73",
      "titleFont": "DM Sans",
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "titleColor": "#172b35"
    }
  },
  "title": "Average Stadium Capacity by Type"
}
